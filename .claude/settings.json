{
  "permissions": {
    "ask": [
      "Bash(npm run *gas:push*)",
      "Bash(npm run *gas:deploy*)",
      "Bash(npm run *gas:sync*)",
      "Bash(npm run *gas:diag*setup=*)",
      "Bash(npm run *gas:diag*run=*)",
      "Bash(node *gas-diag.mjs*setup=*)",
      "Bash(node *gas-diag.mjs*run=*)",
      "Bash(clasp *)",
      "Bash(npx *clasp*)",
      "Bash(*node_modules/.bin/clasp *)",
      "Bash(npm exec *clasp*)",
      "Bash(fnm exec *)",
      "Bash(node *sync-moph-to-gas.js*)",
      "Bash(node *hdc-catalog.js refresh*)",
      "Bash(curl *script.google.com/macros/*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(pkill *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/no-pkill-f.mjs"]
          },
          {
            "type": "command",
            "if": "Bash(pgrep *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/no-pkill-f.mjs"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/thai-reply.mjs"]
          }
        ]
      }
    ]
  }
}
