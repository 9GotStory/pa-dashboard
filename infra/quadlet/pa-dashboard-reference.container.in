# PA Dashboard reference data population (manual one-shot).
#
# Template only — rendered by infra/render-quadlets.mjs with a digest-pinned
# image reference. Loads hospital/tambon reference data from the configured
# reference source. No [Install] section: this unit is started explicitly and
# is never auto-started at boot. RemainAfterExit is intentionally NOT set so
# the unit can be re-run.

[Unit]
Description=PA Dashboard reference data population
Requires=pa-dashboard-migrate.service
After=pa-dashboard-migrate.service

[Container]
Image=@@PA_API_IMAGE@@
Network=pa-dashboard-app.network
EnvironmentFile=%h/.config/pa-dashboard/database.env
EnvironmentFile=%h/.config/pa-dashboard/reference.env
Exec=node dist/src/reference/populate.js

[Service]
Type=oneshot
